
prefix_rule(
    pattern = ["git", "add"],
    decision = "prompt",
    justification = "Ask before staging changes.",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Ask before committing.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Ask before pushing.",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Use a non-destructive recovery method.",
)

prefix_rule(
    pattern = ["git", "clean", "-fd"],
    decision = "forbidden",
    justification = "Avoid deleting untracked files.",
)
